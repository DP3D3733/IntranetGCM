@page "/noticias/edit/{id:int}"
@inject NoticiaService NoticiaService
@rendermode InteractiveServer
@using IntranetGCM.Models
@using IntranetGCM.Services
@using Microsoft.AspNetCore.Components.Forms
@inject IJSRuntime JS
@inject NoticiaService NoticiaService
@inject ToastService ToastService
@inject NavigationManager nav

<Toasts class="p-3" AutoHide="true" Delay="4000" Placement="ToastsPlacement.TopRight" />
<ConfirmDialog @ref="dialog" />
<h3>Editar Notícia</h3>

@if (!carregado)
{
    <p class="loading">Carregando...</p>
}
else
{
    <EditForm Model="@updateNoticiaRequest" OnSubmit="Salvar" FormName="EditarNoticiaForm">
        <DataAnnotationsValidator />

        <div class="layout-topo">
        
            <!-- FOTO CLICÁVEL -->
            <div class="capa-container">
                Capa:
                <img src="@preview"
                     class="capa-img"
                     @onclick="AbrirFilePicker" />
            
                <InputFile id="fileInput"
                           OnChange="SelecionarImagem"
                           style="display:none" />
            </div>

            <!-- CAMPOS -->
            <div class="campos">
                <div class="form-group">
                    <label>Título:</label>
                    <InputText class="input" @bind-Value="updateNoticiaRequest.Titulo" />
                    <ValidationMessage For="@(() => updateNoticiaRequest.Titulo)" />
                </div>

                <div class="form-group">
                    <label>Resumo:</label>
                    <InputText class="input" @bind-Value="updateNoticiaRequest.Resumo" />
                    <ValidationMessage For="@(() => updateNoticiaRequest.Resumo)" />
                </div>

                <div class="form-group">
                    <label>Autor:</label>
                    <InputText class="input" @bind-Value="updateNoticiaRequest.Autor" />
                    <ValidationMessage For="@(() => updateNoticiaRequest.Autor)" />
                </div>

                <div class="form-group">
                    <label>Categoria:</label>
                    <select @bind="updateNoticiaRequest.CategoriaId">
                        <option value="0">Selecione</option>
                        @foreach (var c in categorias)
                        {
                            <option value="@c.Id">@c.Nome</option>
                        }
                    </select>
                </div>
            </div>
        </div>

        <!-- CONTEÚDO EMBAIXO -->
        <div class="form-group mt-3">
            <label>Conteúdo:</label>
            <textarea id="editor" @bind="updateNoticiaRequest.Conteudo"></textarea>
        
        </div>

        <Button Color="ButtonColor.Primary" Type="ButtonType.Submit">
            Salvar
        </Button>
        <Button Color="ButtonColor.Secondary" Type="ButtonType.Button" @onclick="CancelarEdicao">
            Cancelar
        </Button>
        <Button Color="ButtonColor.Danger" Type="ButtonType.Button" @onclick="ShowConfirmationAsync">
            Excluir Notícia
        </Button>
    </EditForm>
}

@code {
    [Parameter]
    public int id { get; set; }

    bool carregado = false;
    private Noticia? noticia;
    public UpdateNoticiaRequest updateNoticiaRequest { get; set; } = new();
    private List<CategoriaNoticia> categorias = new();
    private IBrowserFile imagemSelecionada;
    private string preview;
    private DotNetObjectReference<EditarNoticia>? _objRef;

    private string? imagemFinalUrl;

    private async Task AbrirFilePicker()
    {
        await JS.InvokeVoidAsync("openFilePicker", "fileInput");
    }
    private bool _init;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_init)
        {
            _objRef = DotNetObjectReference.Create(this);
            _init = true;
            await JS.InvokeVoidAsync("tinyHelper.init", "#editor", _objRef);
            await JS.InvokeVoidAsync(
                "tinyHelper.setContent",
                "#editor",
                updateNoticiaRequest.Conteudo
            );
        }
    }

    protected override async Task OnInitializedAsync()
    {
        noticia = await NoticiaService.GetNoticia(id);
        updateNoticiaRequest.Id = noticia.Id;
        updateNoticiaRequest.Titulo = noticia.Titulo;
        updateNoticiaRequest.Resumo = noticia.Resumo;
        updateNoticiaRequest.Conteudo = noticia.Conteudo;
        updateNoticiaRequest.Autor = noticia.Autor;
        updateNoticiaRequest.Ativa = noticia.Ativa;
        updateNoticiaRequest.ImagemUrl = noticia.ImagemUrl;
        updateNoticiaRequest.CategoriaId = noticia.CategoriaId;

        preview = noticia.ImagemUrl;
        categorias = await NoticiaService.ListarCategorias();
        carregado = true;
    }

    private async Task Salvar()
    {
        updateNoticiaRequest.Conteudo = await JS.InvokeAsync<string>("tinyHelper.getValue", "#editor");
        if (updateNoticiaRequest.Conteudo is null || updateNoticiaRequest.Conteudo == "")
        {
            ToastService.Notify(new(ToastType.Danger, $"Erro: Conteúdo da notícia não pode estar em branco"));
            return;
        }

        if (updateNoticiaRequest.CategoriaId == 0)
        {
            ToastService.Notify(new(ToastType.Danger, "Categoria inválida"));
            return;
        }
        if (imagemSelecionada != null)
        {
            string nomeArquivo = Guid.NewGuid() + Path.GetExtension(imagemSelecionada.Name);

            string pastaTemp = Path.Combine("wwwroot/imagens/temp");
            string pastaFinal = Path.Combine("wwwroot/imagens/capas");

            Directory.CreateDirectory(pastaTemp);
            Directory.CreateDirectory(pastaFinal);

            string tempPath = Path.Combine(pastaTemp, nomeArquivo);
            string finalPath = Path.Combine(pastaFinal, nomeArquivo);

            // salva no temp
            using (FileStream stream = new FileStream(tempPath, FileMode.Create))
            {
                await imagemSelecionada
                    .OpenReadStream(5 * 1024 * 1024)
                    .CopyToAsync(stream);
            }

            // move para final
            File.Move(tempPath, finalPath, true);

            updateNoticiaRequest.ImagemUrl = $"/imagens/capas/{nomeArquivo}";
        }

        var resultado = await NoticiaService.AtualizarNoticia(updateNoticiaRequest);

        if (!resultado.success)
        {
            ToastService.Notify(new(ToastType.Danger, $"{resultado.errors}"));
            return;
        }
        ToastService.Notify(new(ToastType.Success, $"Notícia atualizada com sucesso!"));
        nav.NavigateTo($"/noticias/{id}");
    }

    private async Task SelecionarImagem(InputFileChangeEventArgs e)
    {
        imagemSelecionada = e.File;

        var fileName = $"{Guid.NewGuid()}{Path.GetExtension(e.File.Name)}";
        var folder = Path.Combine("wwwroot/imagens/temp");

        Directory.CreateDirectory(folder);

        var path = Path.Combine(folder, fileName);

        await using var stream = new FileStream(path, FileMode.Create);
        await imagemSelecionada.OpenReadStream(5 * 1024 * 1024)
                               .CopyToAsync(stream);

        // URL leve (NÃO base64)
        updateNoticiaRequest.ImagemUrl = $"/imagens/temp/{fileName}";
        preview = updateNoticiaRequest.ImagemUrl;

    }

    void Informar()
    {
        Console.WriteLine("Inválido");
    }

    [JSInvokable]
    public void AtualizarConteudo(string value)
    {
        updateNoticiaRequest.Conteudo = value;
    }

    void CancelarEdicao()
    {

        nav.NavigateTo($"/noticias/{id}");
    }

    private async Task ExcluirNoticia()
    {
        var (successExcluir, errorsExcluir) = await NoticiaService.ExcluirNoticia(id);

        if (!successExcluir)
        {
            foreach (string error in errorsExcluir)
            {
                ToastService.Notify(new(ToastType.Danger, $"Erro: {error}"));
                Console.WriteLine(error);
            }
            return;
        }
        ToastService.Notify(new(ToastType.Success, "Notícia excluída com sucesso"));
        nav.NavigateTo("/noticias");
    }

    private ConfirmDialog dialog = default!;

    private async Task ShowConfirmationAsync()
    {
        var options = new ConfirmDialogOptions
        {
            YesButtonText = "Excluir",
            YesButtonColor = ButtonColor.Danger,
            NoButtonText = "Cancelar",
            NoButtonColor = ButtonColor.Secondary
        };
        var confirmation = await dialog.ShowAsync(
            title: "Tem certeza que deseja excluir essa notícia?",
            message1: "Não será possível desfazer a operação. Prosseguir?",
            confirmDialogOptions: options);

        if (confirmation)
        {
            await ExcluirNoticia();
        }
    }
}