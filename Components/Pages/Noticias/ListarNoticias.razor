@page "/noticias"
@using IntranetGCM.Models
@using IntranetGCM.Services
@inject NoticiaService NoticiaService
@inject NavigationManager nav
@rendermode InteractiveServer

<div class="pageHead">
    <h3 class="titulo">Notícias</h3>
    <AuthorizeView Roles="Com">
        <Button Color="ButtonColor.Warning" Class="left" @onclick="AcessaTelaNovaNoticia">Nova Notícia</Button>
    </AuthorizeView>
</div>


@if (noticias == null)
{
    <p>Carregando...</p>
}
else if (!noticias.Any())
{
    <p>Não há notícias...</p>
}
else
{
    <div class="grid">
        @foreach (Noticia noticia in noticias)
        {
            <NoticiaCard noticia="noticia" OnClick="() => AcessaNoticia(noticia.Id)" />
        }
    </div>
}

@code {
    private List<Noticia> noticias;
    
    protected override async Task OnInitializedAsync()
    {
        noticias = await NoticiaService.ListarNoticia();
    }

    void AcessaNoticia(int id)
    {
        nav.NavigateTo($"/noticias/{id}");
    }

    void AcessaTelaNovaNoticia()
    {
        nav.NavigateTo("/noticias/nova");
    }
}
